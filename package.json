{
  "name": "swift-ghost",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:python-runtime": "node scripts/sync-python-runtime.mjs",
    "predev": "npm run sync:python-runtime",
    "dev": "vinext dev",
    "prebuild": "npm run sync:python-runtime",
    "build": "vinext build",
    "prebuild:pages": "npm run sync:python-runtime",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node scripts/start.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck:worker",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/python": "^1.1.19",
    "@micropython/micropython-webassembly-pyscript": "1.28.0-6",
    "codemirror": "^6.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  },
  "type": "module"
}
